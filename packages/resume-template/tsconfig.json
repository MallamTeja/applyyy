{
  // All compiler settings live in the root base config, owned by applyyy-bd, so
  // no package can drift from the values the section 20 step 0 spike proved.
  // NOTE: real `//` comments, not "// key" entries — TypeScript validates keys
  // inside compilerOptions and rejects an unknown one with TS5025.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Consumed as source (see package.json exports); emitting would create a
    // stale second copy of the one renderer the approval guarantee depends on.
    "noEmit": true,
    // Node builtins are needed by the TESTS ONLY (node:test, node:crypto,
    // node:fs). src/ deliberately uses none of them — the renderer must stay
    // importable by Deno and by the browser, so a Node API leaking into it
    // would break two of the three runtimes at runtime rather than here.
    "types": ["node"]
  },
  // src and test: the fixtures are typed against the real contract, which is how
  // a fixture that no longer matches shared-types becomes a compile error rather
  // than a test that passes against a resume nothing could actually produce.
  "include": ["src", "test"]
}
