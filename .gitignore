# --- Secrets: the whole point of this file. .env holds 15 Gemini keys,
# --- Supabase service-role key, and Gmail credentials. Never committed.
.env
.env.*
!.env.example

# --- Playwright browser session state. Contains live logged-in cookies
# --- for ATS accounts; leaking these is equivalent to leaking passwords.
worker/.auth/
**/storageState*.json
*.har

# --- Generated resume PDFs and screenshots. Contain personal data
# --- (phone, address, CTC) and are reproducible from the DB anyway.
artifacts/
**/*.generated.pdf
worker/screenshots/

# --- Dependencies and build output
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# --- Supabase CLI local state (includes local DB credentials)
supabase/.temp/
supabase/.branches/

# --- Vercel local link metadata (contains project + org ids)
.vercel/

# --- Editor / OS noise
.DS_Store
Thumbs.db
*.swp

# --- This repo's stray artifact, already present
bash.exe.stackdump

# --- Playwright run output. Screenshots of part-filled application forms carry
# --- personal data (CTC, notice period, contact details); reports are rebuilt
# --- on every run, so nothing here is worth versioning.
playwright-report/
test-results/
blob-report/
.playwright/

# Playwright MCP writes console logs and page SNAPSHOTS here, at the repo root,
# whenever anyone drives a real browser. Seven such files appeared during the
# human-lane verification and were untracked-but-visible, so a `git add -A`
# would have committed browser snapshots of Teja's console — constraint #11
# territory, arriving through a tool nobody chose to run.
#
# The hazard worth naming is the COMBINATION, not either half: a tool that writes
# into the working tree, plus staging that sweeps whatever it finds. Each is fine
# alone. This is the second instance in that family; the first swept a
# deliberately-sabotaged security guard mid-mutation into a commit. Ignoring the
# path removes one half so the combination cannot fire.
.playwright-mcp/

# Belt and braces only: the worker has NO build step — it uses .ts import
# specifiers and runs under Node 24's native type stripping, because
# tsconfig.base.json sets noEmit (required by allowImportingTsExtensions), so
# tsc emits nothing and this directory is never created today. Listed so that
# re-adding a build step cannot quietly start committing compiled output.
worker/dist/
