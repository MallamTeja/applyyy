# Fail the install if the lockfile and package.json disagree, rather than
# silently resolving something new. With five peers installing concurrently a
# quietly-updated lockfile is how streams drift apart.
prefer-frozen-lockfile=true
# Hoist nothing implicitly: a package must declare what it imports. This is what
# stops the worker accidentally compiling against a dependency it never listed.
shamefully-hoist=false
# Node 24 is the pinned runtime (PROJECT_PLAN.md §22); refuse to install under
# anything else rather than producing a build that only works on one machine.
engine-strict=true
