{
  "name": "@applyy/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright applier for applyy: claims approved applications, fills real ATS forms, and stops at DRY_RUN unless explicitly opted out.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "apply": "node src/cli/apply.ts",
    "keepalive": "node src/cli/keepalive.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@applyy/shared-types": "workspace:*",
    "@supabase/supabase-js": "2.47.10",
    "playwright": "1.49.1"
  },
  "devDependencies": {
    "@types/node": "24.0.1",
    "pdfjs-dist": "4.9.155",
    "typescript": "^5.8.0",
    "vitest": "2.1.8"
  }
}
