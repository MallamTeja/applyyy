{
  "name": "@applyy/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright applier for applyy: claims approved applications, fills real ATS forms, and stops at DRY_RUN unless explicitly opted out.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "apply": "node src/cli/apply.ts",
    "assist": "node src/cli/assist.ts",
    "run-one": "node src/cli/run-one.ts",
    "keepalive":"node src/cli/keepalive.ts",
    "scout": "node src/cli/scout.ts",
    "scout:remote": "node src/cli/scout-remote.ts",
    "test": "vitest run",
    "test:e2e": "node --experimental-strip-types test/e2e-runner.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@applyy/resume-template": "workspace:*",
    "@applyy/shared-types": "workspace:*",
    "@supabase/supabase-js": "2.50.0",
    "playwright": "1.55.1"
  },
  "devDependencies": {
    "@types/node": "24.0.1",
    "pdfjs-dist": "4.9.155",
    "typescript": "^5.8.0",
    "vitest": "4.1.11"
  }
}
