# Loaded only by `vite build --mode e2e`, and ABOVE .env.local, so the e2e bundle is
# the same on every machine whether or not a developer has a real .env.local.
# Neither value below is a secret, and neither one reaches a live system:
# test/e2eSuite.test.ts intercepts every https://*.supabase.co/** request.

# The public project URL. It must be this ref: the suite seeds the session under
# `sb-xynqxekcqizwhtskzqrq-auth-token`, and supabase-js derives that key from this host.
VITE_SUPABASE_URL=https://xynqxekcqizwhtskzqrq.supabase.co
# The same unsigned placeholder JWT CI uses ({"alg":"none"}, role "anon", iss says
# placeholder). supabaseConfig.ts only reads the role claim, so "anon" lets the app boot;
# the vite.config.ts service-role guard passes it; it authorizes nothing anywhere.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJyb2xlIjoiYW5vbiIsImlzcyI6ImNpLXBsYWNlaG9sZGVyLW5vdC1hLXJlYWwta2V5In0.ci
