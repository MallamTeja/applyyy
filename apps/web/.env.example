# Copy to .env.local (git-ignored) and fill in. Never commit a filled copy —
# constraint #11.

# The Supabase project URL. Public: it appears in every network request the
# browser makes, so it is not a secret.
VITE_SUPABASE_URL=https://xynqxekcqizwhtskzqrq.supabase.co

# The ANON key, and only ever the anon key. §10 defense 4: the frontend relies
# on RLS for authorisation, and the service-role key must never enter a bundle
# Vercel serves. src/data/supabase.ts decodes this token at boot and refuses to
# start if its role claim is anything other than "anon", so a paste mistake
# fails immediately instead of shipping.
#
# If an operation seems to need the service-role key, that operation belongs in
# a Supabase Edge Function — ask the orchestrator rather than widening this.
VITE_SUPABASE_ANON_KEY=
