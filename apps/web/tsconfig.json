{
  // Inherits the monorepo dialect so this app cannot drift from the other
  // streams; only the browser-specific parts are overridden below.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The base config declares ES2022 only, because Deno and Node targets share
    // it. The browser bundle additionally needs DOM lib or every `document`
    // reference fails to typecheck.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // React 18 automatic runtime: no `import React` ceremony in every TSX file,
    // which matters when there are forty of them.
    "jsx": "react-jsx",
    // Vite owns emit; tsc runs purely as a typechecker in the build script, so
    // emitting anything here would produce stray artefacts next to sources.
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    // `module` and `moduleResolution` are a coupled pair in tsc, and the base
    // config sets BOTH to nodenext for the Deno/Node packages. Overriding only
    // the resolution half is rejected outright (TS5095 + TS5109), so the browser
    // project has to restate both. ESNext is what Vite emits anyway.
    "module": "ESNext",
    // Bundler resolution is correct for Vite and lets us import without file
    // extensions; unlike the shared resume template, this app never runs in Deno.
    "moduleResolution": "Bundler",
    // Lets a source file write `./keyRole.ts` instead of `./keyRole`. Needed
    // because `node --test` runs these .ts sources directly and Node's ESM
    // resolver requires the extension on value imports, where Vite does not
    // care. Safe with noEmit: nothing is rewritten, so the specifier that
    // typechecks is the one that runs. Matches how packages/resume-template
    // already writes its imports.
    "allowImportingTsExtensions": true,
    // Vite injects import.meta.env typings through this reference.
    "types": ["vite/client"]
  },
  // Only application sources are roots. vite.config.ts runs in Node, not the
  // browser, so it is typechecked by its own project below.
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
